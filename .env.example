# اختیاری: آدرس پروکسی برای دسترسی به اینستاگرام
# اگر خالی بماند، برنامه خودش پروکسی محلی (v2rayN/Clash) را تشخیص می‌دهد
# و می‌توانید از داخل برنامه (صفحه مدیریت ← تنظیمات پروکسی) آن را تست و ذخیره کنید.
# مثال‌ها:
# INSTAGRAM_PROXY=socks5://127.0.0.1:10808
# INSTAGRAM_PROXY=http://127.0.0.1:10809
INSTAGRAM_PROXY=
